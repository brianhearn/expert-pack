{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expertpack.dev/schemas/frontmatter.schema.json",
  "title": "ExpertPack Content-File Frontmatter",
  "description": "Standards-based JSON Schema for the frontmatter contract enforced by ep-validate --strict. Parse a file's YAML frontmatter to an object and validate it against this schema.",
  "type": "object",
  "required": [
    "title",
    "type",
    "tags",
    "pack",
    "id",
    "schema_version",
    "retrieval_strategy",
    "verified_at",
    "content_hash"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "pack": { "type": "string", "minLength": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/.+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "retrieval_strategy": {
      "type": "string",
      "enum": ["standard", "atomic", "navigation"]
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "verified_by": { "type": "string" },
    "confidence": {
      "type": "string",
      "enum": ["expert-verified", "crawled", "inferred"]
    },
    "concept_scope": {
      "type": "string",
      "enum": ["single", "reference", "multi", "navigation"]
    },
    "valid_from": { "type": "string", "format": "date" },
    "recorded_at": { "type": "string", "format": "date" },
    "refresh": {
      "description": "Volatile TTL (Core 4.2): ISO 8601 duration after fetched_at when the content should be refreshed. Overrides manifest freshness.refresh_cycle for age staleness. Inline <!-- refresh --> blocks in the body are a separate, per-fact mechanism.",
      "type": "string",
      "pattern": "^P(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?$"
    },
    "fetched_at": {
      "description": "Volatile (Core 4.2): ISO date the source was last fetched.",
      "type": "string",
      "format": "date"
    },
    "expires_at": {
      "description": "Volatile (Core 4.2): ISO date after which consumers treat the content as expired.",
      "type": "string",
      "format": "date"
    },
    "source": { "type": "string" },
    "related": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "requires": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "supersedes": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "activation": {
      "type": "object",
      "description": "Knowledge Activation block for operational atoms (workflow, decision, gotcha, phase).",
      "properties": {
        "tools": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "next": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
